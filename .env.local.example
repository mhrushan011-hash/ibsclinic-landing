# IBS Clinic Landing Page — env vars
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real values.

# ---------- Resend (email) ----------
# 1. Add domain `mail.ibsclinic.com` in Resend dashboard.
# 2. Add the 3 DNS records (SPF, DKIM, MX) Resend gives you, in Hostinger DNS Zone Editor.
# 3. Verify the domain in Resend.
# 4. Generate a NEW API key (do NOT reuse the one pasted in chat).
RESEND_API_KEY=

# Sender for transactional emails — must be at the verified domain.
RESEND_FROM="IBS Clinic <consultation@mail.ibsclinic.com>"

# ---------- Clinic notification ----------
# Where new lead emails go (clinic inbox).
CLINIC_NOTIFY_EMAIL=info@ibsclinic.com
CLINIC_NOTIFY_PHONE=917500334343

# ---------- Google Sheets backup ----------
# Apps Script Web App URL. See scripts/google-sheets-apps-script.js for setup.
# Owner: mhrushan011@gmail.com
GOOGLE_SHEETS_WEBHOOK_URL=

# Separate webhook for the long-form patient intake form (column schema differs).
# If unset, the patient intake backup falls back to GOOGLE_SHEETS_WEBHOOK_URL.
GOOGLE_SHEETS_PATIENT_WEBHOOK_URL=

# ---------- Tracking (client-visible) ----------
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_ADS_CONVERSION_ID=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=

# ---------- Site URL (used in OG tags) ----------
NEXT_PUBLIC_SITE_URL=https://consultation.ibsclinic.com

# ---------- Optional: Cloudflare Turnstile (anti-bot) ----------
# Add later if spam becomes a problem.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
