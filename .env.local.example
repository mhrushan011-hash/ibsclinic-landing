# IBS Clinic Landing Page — env vars
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real values.

# ---------- Forms (client-visible) ----------
# Both forms POST straight from the browser — no server route — so this flow
# keeps working after the WordPress/Hostinger migration.
#
# formsubmit.co destination: a hashed token (recommended, hides the email) or the
# raw clinic email. The FIRST real submission triggers a ONE-TIME activation
# email to this address — click the link once to enable delivery.
NEXT_PUBLIC_FORMSUBMIT_ENDPOINT=info@ibsclinic.com

# Apps Script Web App /exec URL — short LeadForm → Google Sheet (CSV-exportable).
# The long patient-intake form is email-only and does NOT post here.
# See tools/lead-capture/leads-to-sheet.gs for deploy steps. Owner: mhrushan011@gmail.com
NEXT_PUBLIC_LEAD_SHEET_WEBHOOK_URL=

# ---------- Tracking (client-visible) ----------
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_ADS_CONVERSION_ID=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=

# ---------- Site URL (used in OG tags) ----------
NEXT_PUBLIC_SITE_URL=https://ibsclinic.com

# ---------- Optional: Cloudflare Turnstile (anti-bot) ----------
# Add later if spam becomes a problem.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
